# Railway Postgres connection string. Use Railway's PUBLIC proxy URL here
# (not the private/internal one) — Vercel functions run outside Railway's
# network and can't reach the internal hostname.
DATABASE_URL=

# Resend
RESEND_API_KEY=
# Sending domain — leave blank until the domain is verified in Resend
RESEND_FROM_EMAIL=

# Where admin notifications for new inquiries go
ADMIN_EMAIL=

# Public site URL, used for absolute links + sitemap generation
NEXT_PUBLIC_SITE_URL=
